{
  "name": "apex-omnihub-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev -w omnihub-dashboard",
    "dev:site": "npm run dev -w omnihub-site",
    "build:dashboard": "npm run build -w omnihub-dashboard",
    "build:site": "npm run build -w omnihub-site",
    "typecheck": "npm run typecheck -w omnihub-dashboard && npm run typecheck -w omnihub-site",
    "test": "npm test -w omnihub-dashboard && npm test -w omnihub-site",
    "guardian:status": "tsx scripts/guardian/status.ts",
    "omnilink:health": "tsx scripts/omnilink/health.ts",
    "zero-trust:baseline": "tsx scripts/zero-trust/baseline-cli.ts",
    "dr:test": "tsx scripts/dr/run-dr-test.ts --dry-run",
    "security:audit": "npm audit --json > security/npm-audit-latest.json || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
