    "test:wwwct:sandbox": "tsx scripts/worldwide-wildcard/run.ts --mode sandbox",
    "test:wwwct:report": "tsx scripts/worldwide-wildcard/run.ts --mode mock --report-dir tests/worldwide-wildcard/reports",
