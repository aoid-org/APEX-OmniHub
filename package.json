    "secret:scan": "node scripts/secret-scan.mjs",
    "security:audit": "node -e \"const fs=require('fs');const dir='security';if(!fs.existsSync(dir))fs.mkdirSync(dir,{recursive:true});\" && npm audit --json > security/npm-audit-latest.json || true",
    "sim:chaos": "tsx sim/cli.ts --mode chaos",
    "sim:dry": "tsx sim/cli.ts --mode dry",
    "sim:quick": "tsx sim/cli.ts --mode quick",
    "sim:burst": "tsx sim/cli.ts --mode burst",
