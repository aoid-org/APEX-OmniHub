    "format:py": "cd orchestrator && python -m ruff format .",
    "test:py": "cd orchestrator && python -m pytest -q",
    "ci:py": "npm run lint:py && npm run test:py",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:node": "hardhat node",
    "hardhat:deploy:local": "hardhat run scripts/hardhat/deploy.ts --network localhost",
    "hardhat:deploy:sepolia": "hardhat run scripts/hardhat/deploy.ts --network sepolia",
    "hardhat:deploy:amoy": "hardhat run scripts/hardhat/deploy.ts --network amoy",
    "hardhat:deploy:mainnet": "hardhat run scripts/hardhat/deploy.ts --network mainnet",
    "hardhat:deploy:polygon": "hardhat run scripts/hardhat/deploy.ts --network polygon",
    "hardhat:mint": "hardhat run scripts/hardhat/mint.ts",
