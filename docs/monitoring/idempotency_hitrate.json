{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Idempotency Hit Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(idempotency_hits_total[5m])) / (sum(rate(idempotency_hits_total[5m])) + sum(rate(idempotency_misses_total[5m])))",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "title": "Hits vs Misses (rate/5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(idempotency_hits_total[5m]))",
          "legendFormat": "Hits",
          "refId": "A"
        },
        {
          "expr": "sum(rate(idempotency_misses_total[5m]))",
          "legendFormat": "Misses",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["apex", "idempotency", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "APEX Idempotency Hit Rate",
  "uid": "apex-idempotency-hitrate",
  "version": 1,
  "alertRules": [
    {
      "name": "Idempotency Hit Rate Low",
      "condition": "sum(rate(idempotency_hits_total[5m])) / (sum(rate(idempotency_hits_total[5m])) + sum(rate(idempotency_misses_total[5m]))) < 0.95",
      "for": "5m",
      "labels": { "severity": "warning" },
      "annotations": {
        "summary": "Idempotency hit rate below 95% for 5 minutes"
      }
    }
  ]
}
