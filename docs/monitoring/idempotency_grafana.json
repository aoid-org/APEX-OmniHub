{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "title": "APEX Idempotency Monitoring",
  "uid": "apex-idempotency",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Idempotency Hit Rate (Target ≥ 95%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(idempotency_hits_total[5m])) / (sum(rate(idempotency_hits_total[5m])) + sum(rate(idempotency_misses_total[5m])))",
          "legendFormat": "hit_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.90 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 2,
      "title": "Hits vs Misses (Rate /s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(idempotency_hits_total[1m]))",
          "legendFormat": "hits/s"
        },
        {
          "expr": "sum(rate(idempotency_misses_total[1m]))",
          "legendFormat": "misses/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Hits by Workflow Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (workflow_type)(rate(idempotency_hits_total[5m]))",
          "legendFormat": "{{ workflow_type }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Misses by Workflow Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (workflow_type)(rate(idempotency_misses_total[5m]))",
          "legendFormat": "{{ workflow_type }}"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 38,
  "alerts": [
    {
      "name": "Idempotency Hit Rate Below 95%",
      "conditions": [
        {
          "evaluator": { "params": [0.95], "type": "lt" },
          "operator": { "type": "and" },
          "query": {
            "params": ["A", "5m", "now"]
          },
          "reducer": { "type": "avg" },
          "type": "query"
        }
      ],
      "executionErrorState": "alerting",
      "for": "5m",
      "frequency": "1m",
      "message": "ALERT: Idempotency hit rate dropped below 95% over the last 5 minutes. Investigate semantic cache health.",
      "noDataState": "no_data",
      "notifications": []
    }
  ]
}
