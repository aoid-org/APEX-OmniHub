{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    // INTENTIONAL SPLIT: '@/*' here resolves to apps/omnihub-site/src/* for the app build.
    // vitest.config.ts resolves '@' to ./src (root package) so tests import root modules.
    // Do NOT align these — the split is load-bearing. See also vitest.config.ts resolve.alias.
    "paths": {
      "@/dashboard/*": ["./apps/omnihub-site/dashboard/*"],
      "@/*": ["./apps/omnihub-site/src/*"]
    },
    "noImplicitAny": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "strict": true,
    "ignoreDeprecations": "6.0"
  }
}
