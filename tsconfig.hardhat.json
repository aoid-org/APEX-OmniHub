{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "hardhat.config.cts",
    "tests/contracts/**/*",
    "tools/scripts/hardhat/**/*"
  ],
  "exclude": ["node_modules", "dist", "coverage", "apps", "packages"],
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
