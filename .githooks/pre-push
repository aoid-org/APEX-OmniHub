#!/usr/bin/env bash
# .githooks/pre-push
# Verifies that /research PRD documentation exists before allowing push.
# This ensures every push has accompanying product requirement docs.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
RESEARCH_DIR="${REPO_ROOT}/research"

echo "🔍 Pre-push: verifying /research PRD documentation..."

if [ ! -d "$RESEARCH_DIR" ]; then
  echo "❌ ERROR: /research directory does not exist."
  echo "   PRD documentation is required before pushing."
  echo "   Create the directory and add your PRD docs:"
  echo "     mkdir -p research"
  echo "     # Add your PRD markdown files"
  exit 1
fi

# Check that at least one file exists in /research
FILE_COUNT=$(find "$RESEARCH_DIR" -type f | wc -l)
if [ "$FILE_COUNT" -eq 0 ]; then
  echo "❌ ERROR: /research directory is empty."
  echo "   At least one PRD document is required before pushing."
  exit 1
fi

echo "✅ Pre-push: /research PRD documentation found (${FILE_COUNT} file(s))."
