#!/usr/bin/env bash
# Enforce conventional commit format on every commit message.
# Runs: @commitlint/cli against .commitlintrc.json
# Blocks commits that don't follow: type(scope?): subject

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits and fixup commits
if echo "$COMMIT_MSG" | grep -qE "^(Merge|fixup!|squash!)"; then
  exit 0
fi

# Run commitlint
if command -v bunx &>/dev/null; then
  bunx commitlint --edit "$COMMIT_MSG_FILE"
elif command -v npx &>/dev/null; then
  npx commitlint --edit "$COMMIT_MSG_FILE"
else
  echo "⚠️  commitlint: not installed, skipping (run bun install)"
fi
