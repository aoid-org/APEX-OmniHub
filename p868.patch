+      id: `cov-test-${Date.now()}-pay`,
+      description: 'Payment change',
+      modifiedFiles: ['src/payment/processor.ts'],
+      touchesUI: false,
+      touchesSecurity: false,
+      timestamp: new Date().toISOString(),
