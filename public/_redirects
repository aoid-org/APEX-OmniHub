# ── Cloudflare Pages Redirect / Rewrite Rules ────────────────────────────
#
# Priority order: actual static files always override rules below.
# /manifesto.html is a real file in dist/ — CF Pages serves it directly.
# These rules cover clean-URL access + legacy alias canonicalisation.

# Legacy alias → canonical static asset (permanent)
/apex-manifesto.html   /manifesto.html  301
/apex-manifesto        /manifesto.html  301

# SPA fallback — serve index.html for all unmatched paths (200 = no URL change)
# Static files in dist/ (incl. manifesto.html) always take priority over this.
/*  /index.html  200

