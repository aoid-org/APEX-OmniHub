      "id": "n-route-events",
      "name": "Route Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ -620, 160 ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body || {};\nconst out = [];\nfor (const entry of (body.entry || [])) {\n  const page_id = entry.id;\n  for (const ch of (entry.changes || [])) {\n    const v = ch.value || {};\n    if (ch.field === 'feed' && v.item === 'comment' && v.verb === 'add') {\n      if (!v.from || !v.from.id) continue;\n      if (v.from.id === page_id) continue;\n      out.push({ json: { event_type: 'comment', page_id, post_id: v.post_id || '', comment_id: v.comment_id || '', fb_id: v.from.id, comment_text: v.message || '' } });\n    }\n  }\n  for (const m of (entry.messaging || [])) {\n    if (m.message && m.message.is_echo) continue;\n    if (m.delivery || m.read) continue;\n    if (!m.sender || !m.sender.id) continue;\n    if (!m.message || typeof m.message.text !== 'string') continue;\n    out.push({ json: { event_type: 'message', page_id, fb_id: m.sender.id, message_text: m.message.text } });\n  }\n}\nif (out.length === 0) out.push({ json: { event_type: 'ignore' } });\nreturn out;"
      }
    },
