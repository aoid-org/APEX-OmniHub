        "jsCode": "const arr = Array.isArray($json.body) ? $json.body : [];\nconst token = arr[0] ? (arr[0].page_access_token || '') : '';\nif (!token) {\n  throw new Error('Page token not found for page_id ' + ($('Comment Context').item.json.page_id || ''));\n}\nreturn [{ json: { page_access_token: token } }];"
