      "typeVersion": 2,
      "position": [ 920, 340 ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function norm(s){\n  s = (s || '').toString().trim().toLowerCase();\n  s = s.replace(/[\\u0640\\u064B-\\u0652\\u0670]/g, '');\n  s = s.replace(/[\\u0623\\u0625\\u0622]/g, '\\u0627');\n  s = s.replace(/\\u0629/g, '\\u0647');\n  s = s.replace(/\\u064A/g, '\\u0649');\n  s = s.replace(/[`'\\u2019\\-_.]/g, ' ').replace(/\\s+/g, ' ').trim();\n  s = s.replace(/^(le |la |l |el )/, '');\n  s = s.replace(/^\\u0627\\u0644/, '');\n  return s;\n}\nconst variants = {\n  'Tunis': ['tunis','tounes','\\u062a\\u0648\\u0646\\u0633','\\u062a\\u0648\\u0646\\u0633 \\u0627\\u0644\\u0639\\u0627\\u0635\\u0645\\u0629'],\n  'Ariana': ['ariana','aryana','aryanah','l ariana','\\u0623\\u0631\\u064a\\u0627\\u0646\\u0629','\\u0627\\u0631\\u064a\\u0627\\u0646\\u0629'],\n  'Ben Arous': ['ben arous','\\u0628\\u0646 \\u0639\\u0631\\u0648\\u0633','\\u0628\\u0646\\u0639\\u0631\\u0648\\u0633'],\n  'Manouba': ['manouba','mannouba','la manouba','manuba','\\u0645\\u0646\\u0648\\u0628\\u0629'],\n  'Nabeul': ['nabeul','nabel','\\u0646\\u0627\\u0628\\u0644'],\n  'Zaghouan': ['zaghouan','\\u0632\\u063a\\u0648\\u0627\\u0646'],\n  'Bizerte': ['bizerte','bizerta','\\u0628\\u0646\\u0632\\u0631\\u062a'],\n  'Beja': ['beja','\\u0628\\u0627\\u062c\\u0629'],\n  'Jendouba': ['jendouba','\\u062c\\u0646\\u062f\\u0648\\u0628\\u0629'],\n  'Le Kef': ['le kef','kef','el kef','\\u0627\\u0644\\u0643\\u0627\\u0641','\\u0643\\u0627\\u0641'],\n  'Siliana': ['siliana','\\u0633\\u0644\\u064a\\u0627\\u0646\\u0629'],\n  'Sousse': ['sousse','soussa','\\u0633\\u0648\\u0633\\u0629'],\n  'Monastir': ['monastir','\\u0627\\u0644\\u0645\\u0646\\u0633\\u062a\\u064a\\u0631','\\u0645\\u0646\\u0633\\u062a\\u064a\\u0631'],\n  'Mahdia': ['mahdia','\\u0627\\u0644\\u0645\\u0647\\u062f\\u064a\\u0629','\\u0645\\u0647\\u062f\\u064a\\u0629'],\n  'Sfax': ['sfax','safaqis','\\u0635\\u0641\\u0627\\u0642\\u0633'],\n  'Kairouan': ['kairouan','kairwan','\\u0627\\u0644\\u0642\\u064a\\u0631\\u0648\\u0627\\u0646','\\u0642\\u064a\\u0631\\u0648\\u0627\\u0646'],\n  'Kasserine': ['kasserine','\\u0627\\u0644\\u0642\\u0635\\u0631\\u064a\\u0646','\\u0642\\u0635\\u0631\\u064a\\u0646'],\n  'Sidi Bouzid': ['sidi bouzid','\\u0633\\u064a\\u062f\\u064a \\u0628\\u0648\\u0632\\u064a\\u062f'],\n  'Gabes': ['gabes','\\u0642\\u0627\\u0628\\u0633'],\n  'Medenine': ['medenine','\\u0645\\u062f\\u0646\\u064a\\u0646'],\n  'Tataouine': ['tataouine','\\u062a\\u0637\\u0627\\u0648\\u064a\\u0646'],\n  'Gafsa': ['gafsa','\\u0642\\u0641\\u0635\\u0629'],\n  'Tozeur': ['tozeur','\\u062a\\u0648\\u0632\\u0631'],\n  'Kebili': ['kebili','kbili','\\u0642\\u0628\\u0644\\u064a']\n};\nconst lookup = {};\nfor (const canon in variants) { for (const v of variants[canon]) { lookup[norm(v)] = canon; } }\nconst raw = ($json.message_text || '').trim();\nconst canonical = lookup[norm(raw)] || null;\nreturn [{ json: { ...$json, gov_valid: !!canonical, governorate: canonical || raw } }];"
      }
    },
