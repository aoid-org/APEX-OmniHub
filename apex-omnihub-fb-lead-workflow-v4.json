    {
      "id": "n-verify-signature",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ -1280, 240 ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.META_APP_SECRET || '';\nconst headers = $json.headers || {};\nconst sigHeader = headers['x-hub-signature-256'] || headers['X-Hub-Signature-256'] || '';\nlet raw = '';\nconst bin = $input.first().binary;\nif (bin && bin.data && bin.data.data) {\n  raw = Buffer.from(bin.data.data, 'base64').toString('utf8');\n} else if (typeof $json.rawBody === 'string') {\n  raw = $json.rawBody;\n} else {\n  raw = JSON.stringify($json.body || {});\n}\nlet valid = false;\nif (secret && sigHeader.startsWith('sha256=')) {\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex');\n  try {\n    const a = Buffer.from(expected);\n    const b = Buffer.from(sigHeader);\n    valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n  } catch (e) { valid = false; }\n}\nlet body = $json.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) {} }\nif ((!body || typeof body !== 'object') && raw) { try { body = JSON.parse(raw); } catch (e) { body = {}; } }\nreturn [{ json: { valid, body: body || {} } }];"
      }
    },
