# Service URLs
OMNIHUB_BASE_URL=http://127.0.0.1:5173
SBBL_BASE_URL=http://127.0.0.1:8787
OMNIHUB_WS_URL=ws://127.0.0.1:5173/ws/telemetry

# Supabase (required)
# Either SBBL_* or generic SUPABASE_* aliases may be used
SBBL_SUPABASE_URL=
SUPABASE_URL=
SBBL_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Integration test users (required)
INTEGRATION_ADMIN_EMAIL=
INTEGRATION_ADMIN_PASSWORD=
INTEGRATION_FAN_EMAIL=
INTEGRATION_FAN_PASSWORD=

# Optional PPV aliases (specs accept either)
INTEGRATION_PPV_ACCESS_CODE=
INTEGRATION_PPV_GAME_ID=
TEST_PPV_ACCESS_CODE=
TEST_PPV_GAME_ID=

# Local checkout paths (runner defaults)
OMNIHUB_REPO=..
SBBL_REPO=../sbbl-hq
