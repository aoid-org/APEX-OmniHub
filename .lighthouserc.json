{
  "//": "PR/push config — accessibility + best-practices are BLOCKING. Performance and SEO are not asserted here; they are evaluated nightly via .lighthouserc.nightly.json. The accessibility floor is a REGRESSION ratchet set at the current achievable score (0.85); the 0.90 aspirational target is tracked (advisory) in .lighthouserc.nightly.json. Raise this floor as accessibility improves.",
  "ci": {
    "collect": {
      "url": ["http://localhost:4173", "http://localhost:4173/demo"],
      "startServerCommand": "npm run preview -- --port 4173",
      "startServerReadyPattern": "Local.*4173",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility":  ["error", {"minScore": 0.85}],
        "categories:best-practices": ["error", {"minScore": 0.85}],
        "categories:performance":    "off",
        "categories:seo":            "off",
        "first-contentful-paint":    "off",
        "interactive":               "off",
        "color-contrast":            ["warn",  {"minScore": 1}],
        "image-alt":                 ["error", {"minScore": 1}],
        "label":                     ["error", {"minScore": 1}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
