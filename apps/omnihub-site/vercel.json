{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/advanced-analytics", "destination": "/advanced-analytics.html" },
    { "source": "/advanced-analytics/", "destination": "/advanced-analytics.html" },
    { "source": "/ai-automation", "destination": "/ai-automation.html" },
    { "source": "/ai-automation/", "destination": "/ai-automation.html" },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/demo/", "destination": "/demo.html" },
    { "source": "/fortress", "destination": "/fortress.html" },
    { "source": "/fortress/", "destination": "/fortress.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/login/", "destination": "/login.html" },
    { "source": "/maestro", "destination": "/maestro.html" },
    { "source": "/maestro/", "destination": "/maestro.html" },
    { "source": "/man-mode", "destination": "/man-mode.html" },
    { "source": "/man-mode/", "destination": "/man-mode.html" },
    { "source": "/omniport", "destination": "/omniport.html" },
    { "source": "/omniport/", "destination": "/omniport.html" },
    { "source": "/orchestrator", "destination": "/orchestrator.html" },
    { "source": "/orchestrator/", "destination": "/orchestrator.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/request-access", "destination": "/request-access.html" },
    { "source": "/request-access/", "destination": "/request-access.html" },
    { "source": "/smart-integrations", "destination": "/smart-integrations.html" },
    { "source": "/smart-integrations/", "destination": "/smart-integrations.html" },
    { "source": "/tech-specs", "destination": "/tech-specs.html" },
    { "source": "/tech-specs/", "destination": "/tech-specs.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/tri-force", "destination": "/tri-force.html" },
    { "source": "/tri-force/", "destination": "/tri-force.html" },
    {
      "source": "/((?!assets|schema|icons|robots.txt|sitemap.xml|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "unsafe-none"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    }
  ]
}
