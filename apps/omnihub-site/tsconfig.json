{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["./src/components/ui/*", "../../src/components/ui/*"],
      "@/stores/*": ["./src/stores/*", "../../src/stores/*"],
      "@/lib/*": ["./src/lib/*", "../../src/lib/*"],
      "@/hooks/*": ["./src/hooks/*", "../../src/hooks/*"],
      "@/contexts/*": ["./src/contexts/*", "../../src/contexts/*"],
      "@/omnidash/*": ["./src/omnidash/*", "../../src/omnidash/*"],
      "@/dashboard/*": ["./dashboard/*", "../../dashboard/*"],
      "@omniconnect/*": ["../../src/omniconnect/*"],
      "@/*": ["./src/*", "../../src/*"]
    }
  },
  "include": ["src", "dashboard", "../../packages/core/src"]
}
