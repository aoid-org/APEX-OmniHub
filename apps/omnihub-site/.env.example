# APEX OmniHub - Required Environment Variables
# Copy to .env.local for local development.
# Set ALL variables in: Vercel -> Project -> Settings -> Environment Variables

# -- Supabase (REQUIRED) ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -- Application ------------------------------------------------------------
VITE_APP_ENV=production
VITE_APP_URL=https://apexomnihub.icu

# -- Optional Site Overrides ------------------------------------------------
VITE_DASHBOARD_URL=https://app.apexomnihub.icu
