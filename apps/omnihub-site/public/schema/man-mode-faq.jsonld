{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is MAN Mode in APEX OmniHub?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "MAN Mode is a Manual Approval Node governance layer that automatically flags high-risk AI decisions and holds them for Manual Approval Node review before execution. The workflow continues on all other items while the flagged action awaits approval or rejection. Nothing irreversible executes without an explicit approval record."
      }
    },
    {
      "@type": "Question",
      "name": "Is APEX OmniHub compliant with the EU AI Act?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "APEX OmniHub is designed with EU AI Act Article 14 compliance in mind, including mandatory Manual Approval Node governance mechanisms, full audit trails via OmniTrace, and configurable MAN Mode gates for high-risk automated decisions."
      }
    },
    {
      "@type": "Question",
      "name": "What does reversible mean in enterprise AI orchestration?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reversible means every automated action executed through APEX OmniHub generates a forensic-grade receipt and rollback path. Operators can replay, inspect, or undo any workflow state via OmniTrace without requiring direct database access."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between flagged, blocked, and held in MAN Mode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In MAN Mode, high-risk items are flagged and held — not silently blocked or silently executed. The workflow continues on all non-flagged items. The held item enters a review queue where an authorized operator can approve (it executes) or reject (it is logged and discarded)."
      }
    },
    {
      "@type": "Question",
      "name": "What does Directable, Auditable, Reversible mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Directable means operators can configure, override, and redirect any workflow at runtime without re-deployment. Auditable means every action and state change is logged with a forensic-grade trail. Reversible means any executed action has a defined rollback path operators can invoke without database access."
      }
    }
  ]
}
