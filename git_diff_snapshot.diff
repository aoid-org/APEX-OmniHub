+name: Secrets Rotation Reminder
+
+# Fires every 85 days — slightly before the 90-day rotation cycle.
+# This is a REMINDER workflow: it does not rotate secrets automatically.
+# Automatic rotation requires Doppler/Vault integration (tracked separately).
+on:
+  schedule:
+    - cron: '0 9 1 */3 *'   # 09:00 UTC on the 1st of every 3rd month
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  rotation-reminder:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Secrets rotation due
+        run: |
+          echo "## :rotating_light: Quarterly Secrets Rotation Due" >> "$GITHUB_STEP_SUMMARY"
+          echo "" >> "$GITHUB_STEP_SUMMARY"
+          echo "Rotate the following secrets per docs/security/SECRETS_INVENTORY_AND_ROTATION.md:" >> "$GITHUB_STEP_SUMMARY"
+          echo "- [ ] VITE_SUPABASE_PUBLISHABLE_KEY (anon key)" >> "$GITHUB_STEP_SUMMARY"
+          echo "- [ ] SUPABASE_SERVICE_ROLE_KEY" >> "$GITHUB_STEP_SUMMARY"
+          echo "- [ ] OPENAI_API_KEY (if used)" >> "$GITHUB_STEP_SUMMARY"
+          echo "- [ ] ALCHEMY_API_KEY_ETH / ALCHEMY_API_KEY_POLYGON" >> "$GITHUB_STEP_SUMMARY"
+          echo "- [ ] ALCHEMY_WEBHOOK_SIGNING_KEY" >> "$GITHUB_STEP_SUMMARY"
+          echo "" >> "$GITHUB_STEP_SUMMARY"
+          echo "**Procedure:** https://github.com/apexbusiness-systems/APEX-OmniHub/blob/main/docs/security/SECRETS_INVENTORY_AND_ROTATION.md" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Post Slack reminder
+        if: env.SLACK_ALERT_WEBHOOK_URL != ''
+        run: |
+          curl -s -X POST "${{ secrets.SLACK_ALERT_WEBHOOK_URL }}" \
+            -H "Content-Type: application/json" \
+            -d '{
+              "text": ":key: *APEX Quarterly Secrets Rotation Reminder*\nRotate: Supabase keys, OpenAI, Alchemy, and all service credentials.\nSee: <https://github.com/apexbusiness-systems/APEX-OmniHub/blob/main/docs/security/SECRETS_INVENTORY_AND_ROTATION.md|Rotation Runbook>"
+            }'
+        env:
+          SLACK_ALERT_WEBHOOK_URL: ${{ secrets.SLACK_ALERT_WEBHOOK_URL }}
